GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=5173

# Use Vertex AI instead of an API key when these are set.
VERTEX_AI=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Optional. Full processor name or id. Without it, a text PDF is read locally.
DOCUMENT_AI_PROCESSOR=
DOCUMENT_AI_LOCATION=us

# Optional. Topic id. Reviews are still stored on the desk without it.
PUBSUB_TOPIC=
